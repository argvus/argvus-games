pkgname=argvus-games
pkgver=0.1.0
pkgrel=1
pkgdesc="Official ARGVUS games meta-package"
arch=('any')
url="https://github.com/argvus/argvus-games"
license=('GPL-3.0-only')
depends=(
  'argvus-game-snake'
)
options=('!debug')
source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
)
sha256sums=()

# shellcheck disable=SC1091
_functions_file="${startdir:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}/../common/functions.sh"
. "$_functions_file"

prepare() {
  arch_normalize_source_tree
}

check() {
  arch_check_metapackage
}

package() {
  arch_package_metapackage
}
